# Canon Camera Control edge API base URL. Falls back to http://localhost:3000
# if unset -- only needs to be set here when the edge API runs elsewhere (a
# separate Mini PC, a different host/IP on the plant network, etc). If set, it
# must be a valid absolute URL or the app will fail fast at startup/build time.
CAMERA_API_URL=http://10.60.20.196:3000

# Optional bearer token for the edge API. Leave unset if the edge API doesn't
# require auth. Never committed -- only .env.example is tracked in git.
# CAMERA_API_TOKEN=

# Network share captures are saved to automatically. THIS APP SERVER does the
# writing: it pulls the bytes from the edge device over /v1/media/:id/content
# and then writes them itself (src/lib/network-save.ts). So this path is
# resolved on whichever machine runs the app -- never on the edge device.
#
# That makes the right value depend on where the app runs:
#
#   Windows (bun dev)   NETWORK_SAVE_ROOT=\\10.1.1.44\Data Analytics\ML\MTI\Calcine Project\Calcine Sample Foto\Foto Sampling
#   Linux / Docker      NETWORK_SAVE_ROOT=/mnt/mti/ML/MTI/Calcine Project/Calcine Sample Foto/Foto Sampling
#
# Stop at the shared parent folder: the app appends the operator's plant as the
# first subfolder, then YYYY/MM/DD, so one value serves every plant.
#
#   <root>/Acid Plant/2026/08/25/<filename>
#   <root>/Chloride Plant/2026/08/25/<filename>
#
# The Linux form needs the share mounted over CIFS on the host and bound into
# the container -- see scripts/mount-network-share.sh and docker-compose.yml.
#
# The app refuses to write when this path is missing at runtime rather than
# creating it, so an unmounted share fails loudly instead of quietly filling
# local disk. Leave unset to disable automatic network saving entirely;
# captures then fall back to the browser folder picker / plain download.
# NETWORK_SAVE_ROOT=\\10.1.1.44\Data Analytics\ML\MTI

# SQL Server registry untuk master data kamera/devices. Pakai user aplikasi
# khusus dengan hak minimum; hindari memakai account sa dari aplikasi.
# CARDDB_USER=capture_app
# CARDDB_PASSWORD=replace-me
# CARDDB_SERVER=10.60.10.47
# CARDDB_NAME=Capture-Calcine
# CARDDB_PORT=1433
# CARDDB_SCHEMA=dbo

# Kunci penyegel cookie sesi login (halaman /login). WAJIB diisi supaya login
# bisa dipakai; tanpa nilai ini setiap percobaan login ditolak dengan pesan
# yang menyebutkan variabel ini, dan seluruh aplikasi tetap terkunci.
#
# Minimal 32 karakter -- lebih pendek dari itu ditolak saat startup/build.
# Tulis bare tanpa kutip. Bikin nilai baru:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Gunakan nilai berbeda per lingkungan, dan jangan pernah commit nilai aslinya.
# SESSION_SECRET=ganti-dengan-nilai-acak-32-karakter-atau-lebih

# --- REST API baca-saja (/api/v1) ---------------------------------------------
# Kunci akses untuk sistem lain: monitoring, LIMS, dasbor pelaporan. Kontrak
# lengkapnya di docs/openapi.yaml.
#
# KOSONG BERARTI API MATI, dan setiap permintaan ke /api/v1 dijawab 503
# API_DISABLED. Itu bawaannya dan disengaja: sebuah API yang menyala diam-diam
# karena variabelnya lupa diisi adalah kegagalan yang tidak terlihat sampai ada
# yang menemukannya.
#
# Pisahkan dengan koma untuk beberapa kunci, dan beri SATU KUNCI PER KONSUMEN.
# Kunci bersama tidak bisa dicabut tanpa memutus semua yang lain sekaligus.
#
# Bikin nilai baru:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Klien mengirimnya di header X-API-Key. API-nya baca-saja, jadi kunci yang
# bocor tidak bisa dipakai menghapus capture atau menulis ke folder jaringan --
# tapi ia tetap bisa membaca seluruh riwayat sampling, jadi perlakukan sebagai
# rahasia.
# API_KEYS=ganti-dengan-nilai-acak

# --- Thumbnail galeri ----------------------------------------------------------
# Gambar kecil (~50 KB, sisi terpanjang 640 px) yang dipakai grid galeri.
#
# DIBUAT DI BROWSER OPERATOR saat capture, bukan di server: pada saat itu
# browser sudah memegang fotonya di memori, jadi tidak perlu pustaka gambar
# native (sharp) di image Docker sama sekali.
#
# Ini yang membuat galeri bisa menampilkan foto dari PC mana pun tanpa terasa
# berat: satu halaman grid 24 kartu turun dari ~264 MB (foto penuh lewat CIFS
# ke 10.1.1.44) jadi ~1 MB dari disk app server.
#
# Di produksi nilainya datang dari docker-compose.yml (named volume
# capture-thumbs) dan tidak perlu ditulis di sini. Kosongkan untuk mematikan
# fiturnya -- galeri lalu kembali memuat foto ukuran penuh, hanya saat kartunya
# dibuka.
#
# Aman dihapus kapan saja: foto aslinya selalu ada di folder jaringan, tidak
# pernah hanya di sini.
#CAPTURE_THUMBS_DIR=
