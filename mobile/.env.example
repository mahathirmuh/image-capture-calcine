# Optional mobile-only overrides.
# By default the app now falls back to root .env:
# 1. MOBILE_API_BASE_URL
# 2. API_BASE_URL
# 3. VITE_API_BASE_URL (this file)
VITE_API_BASE_URL=http://10.60.20.155:26101/api/v1

# Optional mobile-only login API key override.
# Fallback order:
# 1. MOBILE_API_KEY in root .env
# 2. first key from API_KEYS in root .env
# 3. VITE_API_KEY in this file
VITE_API_KEY=replace-with-mobile-login-api-key
